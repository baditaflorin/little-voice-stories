{
  "name": "little-voice-stories",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Turn a kid's drawing into a bedtime story narrated in a parent's voice, entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-pages.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pages:preview": "node scripts/serve-pages.mjs",
    "lint": "eslint . --max-warnings=0",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "smoke": "playwright test",
    "hooks:pre-commit": ".githooks/pre-commit",
    "hooks:commit-msg": ".githooks/commit-msg .git/COMMIT_EDITMSG",
    "hooks:pre-push": ".githooks/pre-push"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.83",
    "@tanstack/react-query": "^5.100.9",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
