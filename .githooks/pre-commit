#!/usr/bin/env sh
set -eu

npm run typecheck
npm run lint
npm run fmt:check
npm run test

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required for pre-commit secret scanning."
  echo "Install from https://github.com/gitleaks/gitleaks"
  exit 1
fi

gitleaks protect --staged --verbose
